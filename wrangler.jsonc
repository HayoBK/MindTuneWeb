// Configuración del Worker de Cloudflare que sirve el sitio como archivos estáticos.
// Cloudflare (Workers & Pages → mindtuneweb) corre primero el "build command" (hugo --gc --minify)
// y después "npx wrangler deploy", que lee este archivo y publica la carpeta public/.
{
  "name": "mindtuneweb",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
